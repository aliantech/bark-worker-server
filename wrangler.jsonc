{
  "name": "bark-worker-server",
  "compatibility_date": "2025-10-08",
  "build": {
    "command": "npm run build:cf"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./dist/handler.js",
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "BARK_KV",
      "id": "8f73403aa45c418a823f59fa21bb1c30"
    }
  ],
  "vars": {
    "ALLOW_NEW_DEVICE": "false",
    "ALLOW_QUERY_NUMS": "false"
  },
  "preview_urls": false
}
